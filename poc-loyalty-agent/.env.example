# GCP Project and Regional Settings
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
BQ_LOCATION=US
BQ_DATASET=loyalty_poc

# Google Cloud Storage for OKF v0.2 Bundle
OKF_BUCKET=your-gcs-bucket-name
OKF_PREFIX=okf_bundle

# LLM Configuration (vertex-gemini | anthropic)
LLM_PROVIDER=vertex-gemini
GOOGLE_GENAI_MODEL=gemini-2.5-flash
# Or Anthropic if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# BigQuery & Query Safety Guardrails
MAX_BYTES_BILLED=104857600   # 100 MB limit per query
MAX_ROWS=1000

# Privacy & PII Masking
SHOW_PII=false

# Google Application Credentials (optional if using ADC via `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

